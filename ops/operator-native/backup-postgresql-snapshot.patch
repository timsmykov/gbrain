+# Hold one read-only PostgreSQL snapshot for the dump and its count manifest.
+# Concurrent application writes continue; no global settings or write locks change.
+coproc GBRAIN_BACKUP_SNAPSHOT { docker exec -i gbrain-postgres psql -X -q -v ON_ERROR_STOP=1 -U "$GBRAIN_POSTGRES_USER" -d "$GBRAIN_POSTGRES_DB" -At -F,; }
+SNAPSHOT_KEEPER_PID="$GBRAIN_BACKUP_SNAPSHOT_PID"
+exec {SNAPSHOT_READ_FD}<&"${GBRAIN_BACKUP_SNAPSHOT[0]}"
+exec {SNAPSHOT_WRITE_FD}>&"${GBRAIN_BACKUP_SNAPSHOT[1]}"
+printf '%s\n' 'BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY;' 'SELECT pg_export_snapshot();' >&"$SNAPSHOT_WRITE_FD"
+read -r -t 30 DB_SNAPSHOT <&"$SNAPSHOT_READ_FD"
+[[ "$DB_SNAPSHOT" =~ ^[0-9A-Fa-f]+-[0-9A-Fa-f]+-[0-9]+$ ]] || { echo "backup: invalid snapshot identifier" >&2; exit 1; }
+docker exec gbrain-postgres pg_dump -U "$GBRAIN_POSTGRES_USER" -d "$GBRAIN_POSTGRES_DB" --snapshot="$DB_SNAPSHOT" --format=custom --no-owner --no-privileges > "$GENERATION_DIR/gbrain.dump"
 pg_restore --list "$GENERATION_DIR/gbrain.dump" >/dev/null
