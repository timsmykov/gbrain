[Unit]
Description=Bounded native GBrain maintenance for %i
After=gbrain-postgres.service gbrain-jobs-supervisor.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/gbrain/gbrain.env
ExecStart=/usr/local/bin/gbrain sweep --once --source %i --budget-ms 5000 --batch-limit 20 --json
TimeoutStartSec=2min
Nice=10
IOSchedulingClass=idle
UMask=0077

